# Copy this file to .env.local and fill in the values you have.
# DeFiHub runs in a degraded-but-honest mode when optional keys are
# missing (e.g. price sync just skips instead of faking data) — see README.

# --- Database (required) ---------------------------------------------------
# Local dev default matches the local PostgreSQL 16 instance set up for this
# project (database "defihub", user "postgres").
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/defihub"

# --- Auth.js (required for login) ------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="CHANGE_ME"

# Optional: Google OAuth. Leave blank to disable "Sign in with Google" and
# fall back to email/password only.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Data providers ----------------------------------------------------------
# Optional. Without it, price sync uses the public CoinGecko endpoint at a
# much lower rate limit (~5-15 req/min vs 100 req/min). Free Demo key:
# https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=""

# --- Multi-chain RPC (on-chain verification + /wallet) -----------------------
# All optional. Each defaults to a free publicnode.com RPC endpoint (verified
# live before shipping) - set your own (Alchemy/Infura/QuickNode free tier)
# for higher reliability/rate limits. Server-side only - read by the on-chain
# verification worker (lib/onchain/) and the wallet balance-reading API
# route; a browser wallet connection itself talks to the wallet extension
# directly and doesn't need any of these.
ETHEREUM_RPC_URL=""
ARBITRUM_RPC_URL=""
BASE_RPC_URL=""
BNB_CHAIN_RPC_URL=""
AVALANCHE_RPC_URL=""
POLYGON_RPC_URL=""
OPTIMISM_RPC_URL=""

# Optional per-chain failover: a second RPC URL tried after the primary
# above is exhausted (bounded retries on transient/timeout/rate-limit
# failures - see lib/chains/rpc-resilient-client.ts). Leave blank to run
# with a single provider per chain, same as before this existed.
ETHEREUM_RPC_URL_FALLBACK=""
ARBITRUM_RPC_URL_FALLBACK=""
BASE_RPC_URL_FALLBACK=""
BNB_CHAIN_RPC_URL_FALLBACK=""
AVALANCHE_RPC_URL_FALLBACK=""
POLYGON_RPC_URL_FALLBACK=""
OPTIMISM_RPC_URL_FALLBACK=""

# --- AI ------------------------------------------------------------------
# Optional. Without it, the "AI summary" button on protocol pages doesn't
# render at all. Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=""

# --- Notifications -----------------------------------------------------------
# Optional. Without it, alert emails are logged to the console instead of
# actually sent. Free tier: https://resend.com
RESEND_API_KEY=""
ALERTS_FROM_EMAIL="alerts@defihub.dev"

# --- Ingestion / cron ---------------------------------------------------------
# Shared secret required as `Authorization: Bearer <this value>` on
# /api/cron/* routes - matches what Vercel automatically sends when it
# invokes a scheduled route, so no extra config is needed in production.
CRON_SECRET="CHANGE_ME"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
