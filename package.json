{
  "name": "defihub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "dotenv -e .env.local -- vitest run",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:migrate:0025-concurrent-indexes": "dotenv -e .env.local -- tsx lib/database/migrations/scripts/0025-create-block-identity-indexes-concurrently.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "seed": "dotenv -e .env.local -- tsx lib/database/seed.ts",
    "sync:protocols": "dotenv -e .env.local -- tsx workers/protocols/sync.ts",
    "sync:chains": "dotenv -e .env.local -- tsx workers/chains/sync.ts",
    "sync:yields": "dotenv -e .env.local -- tsx workers/yields/sync.ts",
    "sync:prices": "dotenv -e .env.local -- tsx workers/prices/sync.ts",
    "sync:tokens": "dotenv -e .env.local -- tsx workers/tokens/sync.ts",
    "verify:onchain": "dotenv -e .env.local -- tsx workers/onchain/verify.ts",
    "price:onchain": "dotenv -e .env.local -- tsx workers/onchain/price.ts",
    "recheck:reorgs": "dotenv -e .env.local -- tsx workers/onchain/recheck-reorgs.ts",
    "sync:all": "npm run sync:chains && npm run sync:protocols && npm run sync:yields && npm run sync:prices && npm run sync:tokens && npm run verify:onchain",
    "check:alerts": "dotenv -e .env.local -- tsx workers/alerts/check.ts",
    "rollup:metrics": "dotenv -e .env.local -- tsx workers/retention/rollup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.0",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.55.18",
    "wagmi": "^3.7.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
